# ─── Hermes Agent — environment template ───────────────────────────────
# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# === Model backend: Anthropic / Claude ===
# Get a key at https://console.anthropic.com  (format: sk-ant-...)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# === OpenAI-compatible API server (port 8642) ===
# External interfaces/clients must send this as a Bearer token.
# Generate a new one with:  openssl rand -hex 32
API_SERVER_KEY=REPLACE_WITH_RANDOM_HEX

# === Web dashboard auth (port 9119) ===
# The dashboard binds to 0.0.0.0 inside the container, so auth is required.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=REPLACE_ME
# Session signing secret — generate with:  openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=REPLACE_WITH_RANDOM_HEX
